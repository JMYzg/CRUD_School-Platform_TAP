<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <Label styleClass="titulo" text="Enunciado de la pregunta:" />
   <TextArea fx:id="txtPregunta" promptText="Ej: ¿Cuál es la capital de Francia?" />

   <Label styleClass="titulo" text="Opciones de respuesta:" />
   <GridPane prefHeight="100.0" prefWidth="393.0">
      <!-- Opción 1 -->
      <Label text="Opción 1:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="txtOpcion1" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      <RadioButton fx:id="rbOpcion1" GridPane.columnIndex="2" GridPane.rowIndex="0">
         <toggleGroup>
            <ToggleGroup fx:id="toggleGroup" />
         </toggleGroup></RadioButton>

      <!-- Opción 2 -->
      <Label text="Opción 2:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <TextField fx:id="txtOpcion2" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <RadioButton fx:id="rbOpcion2" prefHeight="5.0" prefWidth="19.0" toggleGroup="$toggleGroup" GridPane.columnIndex="2" GridPane.rowIndex="1" />

      <!-- Opción 3 -->
      <Label text="Opción 3:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <TextField fx:id="txtOpcion3" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <RadioButton fx:id="rbOpcion3" toggleGroup="$toggleGroup" GridPane.columnIndex="2" GridPane.rowIndex="2" />

      <!-- Opción 4 -->
      <Label text="Opción 4:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
      <TextField fx:id="txtOpcion4" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      <RadioButton fx:id="rbOpcion4" toggleGroup="$toggleGroup" GridPane.columnIndex="2" GridPane.rowIndex="3" />
      <columnConstraints>
         <ColumnConstraints />
         <ColumnConstraints />
         <ColumnConstraints />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints maxHeight="50.0" minHeight="13.0" prefHeight="28.0" />
         <RowConstraints maxHeight="37.0" minHeight="0.0" prefHeight="22.0" />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
   </GridPane>


</VBox>
